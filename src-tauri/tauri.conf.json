{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModelRouter",
  "version": "0.1.0",
  "identifier": "com.modelrouter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ModelRouter - Claude Code 智能模型路由",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": {
      "windows": {
        "nsis": {
          "installMode": "currentUser",
          "languages": ["SimpChinese", "English"]
        },
        "msi": {}
      },
      "macOS": {
        "dmg": {},
        "files": {}
      },
      "linux": {
        "deb": {
          "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
        },
        "rpm": {
          "depends": ["webkit2gtk4.1", "gtk3", "libappindicator-gtk3"]
        },
        "appimage": {}
      }
    },
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/32x32.png"],
    "createUpdaterArtifacts": true
  }
}
